{
  "name": "end-of-the-world-travel-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "demo": "tsx src/cli.ts",
    "api": "tsx src/api/server.ts",
    "test": "vitest run",
    "test:rag": "vitest run tests/ragRegression.test.ts",
    "typecheck": "tsc --noEmit",
    "build:client": "tsc -p tsconfig.client.json",
    "eval:semantic:vercel": "node --env-file=.env --import tsx scripts/evaluateVercelEmbeddings.ts",
    "eval:semantic:gemini": "node --env-file=.env --import tsx scripts/evaluateGeminiEmbeddings.ts",
    "eval:semantic:gemini:v2": "RETRIEVAL_EVAL_FILE=data/retrieval/retrieval-eval-puerto-williams-v2.json node --env-file=.env --import tsx scripts/evaluateGeminiEmbeddings.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "fast-check": "^4.9.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
